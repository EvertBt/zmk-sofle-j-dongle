#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    zip_scroll_scaler: zip_scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        track-remainders;
    };
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <0>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };

        bspc_del: bspc_del {
            compatible = "zmk,behavior-mod-morph";
            label = "BACKSPACE + DEL";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        shift_MB3: shift_MB3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mkp MB3 &kp LEFT_SHIFT>;

            label = "SHIFT_MB3";
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC           &kp N1     &kp N2        &kp N3        &kp N4     &kp N5    &kp UP_ARROW     &kp N6     &kp N7     &kp N8     &kp N9         &kp N0         &bspc_del
&kp TAB           &kp Q      &kp W         &kp E         &kp R      &kp T     &kp DOWN_ARROW   &kp Y      &kp U      &kp I      &kp O          &kp P          &kp MINUS
&kp LEFT_SHIFT    &kp A      &kp S         &kp D         &kp F      &kp G     &kp LEFT_ARROW   &kp H      &kp J      &kp K      &kp L          &kp M          &kp RIGHT_SHIFT
&kp LCTRL         &kp Z      &kp X         &kp C         &kp V      &kp B     &kp RIGHT_ARROW  &kp N      &kp SLASH  &kp COMMA  &kp DOT        &kp SEMICOLON  &kp EQUAL
&kp C_PLAY_PAUSE  &kp LCTRL  &kp LEFT_GUI  &kp LEFT_ALT  &kp SPACE  &mo 1     &trans           &kp SPACE  &kp ENTER  &mo 2      &kp BACKSLASH  &kp APOS
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
            display-name = "layer0";
        };

        layer_1 {
            bindings = <
&kp GRAVE        &kp F1                          &kp F2           &kp F3           &kp F4     &kp F5      &mmv MOVE_UP     &kp F6     &kp F7    &kp F8      &kp F9     &kp F10           &kp F11
&rgb_ug RGB_TOG  &trans                          &mkp LCLK        &mkp MCLK        &mkp RCLK  &mkp MB4    &mmv MOVE_DOWN   &kp PG_UP  &kp END   &kp UP      &kp HOME   &kp MINUS         &kp F12
&rgb_ug RGB_BRI  &rgb_ug RGB_EFF                 &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &trans     &mkp MB5    &mmv MOVE_LEFT   &kp PG_DN  &kp LEFT  &kp DOWN    &kp RIGHT  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&rgb_ug RGB_BRD  &rgb_ug RGB_EFR                 &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &trans     &trans      &mmv MOVE_RIGHT  &trans     &trans    &kp INSERT  &trans     &trans            &trans
&kp C_MUTE       &rgb_ug RGB_COLOR_HSB(58,0,47)  &trans           &trans           &trans     &trans      &trans           &trans     &trans    &trans      &trans     &kp GRAVE
            >;

            display-name = "layer1";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_2 {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &mmv MOVE_UP     &trans       &trans  &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp DEL
&trans  &bt BT_CLR    &bt BT_CLR_ALL  &trans        &trans        &bootloader     &mmv MOVE_DOWN   &bootloader  &trans  &trans  &kp LS(LEFT_BRACKET)  &kp LS(RIGHT_BRACKET)  &trans
&trans  &out OUT_USB  &out OUT_BLE    &trans        &trans        &soft_off       &mmv MOVE_LEFT   &soft_off    &trans  &trans  &trans                &trans                 &trans
&trans  &trans        &trans          &trans        &trans        &sys_reset      &mmv MOVE_RIGHT  &sys_reset   &trans  &trans  &trans                &trans                 &trans
&trans  &trans        &trans          &trans        &trans        &trans          &trans           &trans       &trans  &trans  &trans                &kp GRAVE
            >;

            display-name = "layer2";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "layer3";
        };
    };
};
